{
  "global": {
    "alt-h": "pane.go:left",
    "alt-j": "pane.go:down",
    "alt-k": "pane.go:up",
    "alt-l": "pane.go:right",
    "alt-left": "pane.swap:left",
    "alt-right": "pane.swap:right",
    "alt-up": "pane.swap:up",
    "alt-down": "pane.swap:down",
    "alt-;": "pane.split:down",
    "alt-/": "pane.split:right",
    "alt-x": "pane.close",
    "alt-z": "pane.zoom",

    "alt-c": "tab.new",
    "alt-n": "tab.next",
    "alt-p": "tab.prev",

    "ctrl-,": "app.settings",
    "ctrl-0": "app.zoom_reset",
    "ctrl--": "app.zoom_out",
    "ctrl-=": "app.zoom_in",
    "ctrl-shift-/": "app.help",
    "ctrl-shift-?": "app.help",
    "ctrl-shift-k": "mod.open:picker",
    "ctrl-shift-p": "app.palette",
    "ctrl-shift-l": "layout.switch",

    "alt-s": "layout.toggle:sidebar",

    "ctrl-shift-n": "space.new",
    "ctrl-shift-x": "space.close",
    "ctrl-up": "space.prev",
    "ctrl-down": "space.next",

    "ctrl-alt-up": "agent.prev",
    "ctrl-alt-down": "agent.next",

    "f2": "tab.rename",
    "f3": "space.rename"
  },
  "terminal": {
    "ctrl-backspace": "send:\u0017",
    "ctrl-left": "send:\u001bb",
    "ctrl-right": "send:\u001bf",
    "ctrl-shift-c": "terminal.copy",
    "ctrl-shift-v": "terminal.paste",
    "ctrl-v": "terminal.paste_image"
  }
}
